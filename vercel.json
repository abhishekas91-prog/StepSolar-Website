{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/api/:path*", "destination": "https://stepsolar-backend.onrender.com/api/:path*" },
    { "source": "/track/:path*", "destination": "/track.html" },
    { "source": "/solar-panel-installation-:city/", "destination": "/locations.html?city=:city" },
    { "source": "/solar-panel-installation-:city", "destination": "/locations.html?city=:city" },
    { "source": "/solar-panel-installation-:city/:path*", "destination": "/locations.html?city=:city" },
    { "source": "/locations", "destination": "/locations.html" },
    { "source": "/locations/", "destination": "/locations.html" },
    { "source": "/service-areas", "destination": "/locations.html" },
    { "source": "/service-areas/", "destination": "/locations.html" },
    { "source": "/why-solar", "destination": "/why-solar.html" },
    { "source": "/why-solar/", "destination": "/why-solar.html" },
    { "source": "/pm-surya-ghar", "destination": "/pm-surya-ghar.html" },
    { "source": "/pm-surya-ghar/", "destination": "/pm-surya-ghar.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/gallery/", "destination": "/gallery.html" },
    { "source": "/our-process", "destination": "/our-process.html" },
    { "source": "/our-process/", "destination": "/our-process.html" },
    { "source": "/solutions", "destination": "/solutions.html" },
    { "source": "/solutions/", "destination": "/solutions.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact/", "destination": "/contact.html" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https://stepsolar-backend.onrender.com; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/logo.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/google971aba3b343a2934.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/track/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
